{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendashboard.local/schemas/h2/review-event-request.schema.json",
  "title": "H2ReviewEventRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "runId",
    "eventId",
    "action",
    "expectedRevision",
    "actor"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[\\x21-\\x7E]+$" },
    "runId": { "type": "string", "minLength": 1 },
    "eventId": { "type": "string", "minLength": 1 },
    "action": { "enum": ["confirm", "reject", "resolve", "reopen", "add_note"] },
    "expectedRevision": { "type": "integer", "minimum": 0 },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "displayName"],
      "properties": {
        "kind": { "const": "local_operator" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "note": { "type": "string", "minLength": 1, "maxLength": 2000 }
  }
}
