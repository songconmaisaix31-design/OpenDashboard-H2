{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendashboard.local/schemas/h2/report-descriptor.schema.json",
  "title": "H2ReportDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportId",
    "runId",
    "kind",
    "format",
    "status",
    "generatedAt",
    "filename",
    "contentHash",
    "warnings",
    "safetyDisclaimer",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reportId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "kind": {
      "enum": [
        "single_event_diagnosis",
        "period_summary",
        "pcc_daily_compliance",
        "analysis_result_json",
        "submission_csv",
        "validation_metrics",
        "quality_report",
        "review_audit_json"
      ]
    },
    "format": { "enum": ["html", "json", "csv"] },
    "status": { "enum": ["ready", "failed"] },
    "generatedAt": { "type": "string", "minLength": 1 },
    "filename": { "type": "string", "minLength": 1 },
    "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "eventId": { "type": "string" },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "safetyDisclaimer": { "type": "string", "minLength": 1 },
    "provenance": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "required": ["kind"],
        "properties": { "kind": { "const": "single_event_diagnosis" } }
      },
      "then": {
        "required": ["eventId"],
        "properties": { "format": { "const": "html" } }
      },
      "else": { "not": { "required": ["eventId"] } }
    },
    {
      "if": {
        "required": ["kind"],
        "properties": {
          "kind": {
            "enum": ["period_summary", "pcc_daily_compliance", "quality_report"]
          }
        }
      },
      "then": { "properties": { "format": { "const": "html" } } }
    },
    {
      "if": {
        "required": ["kind"],
        "properties": {
          "kind": {
            "enum": ["analysis_result_json", "validation_metrics", "review_audit_json"]
          }
        }
      },
      "then": { "properties": { "format": { "const": "json" } } }
    },
    {
      "if": {
        "required": ["kind"],
        "properties": { "kind": { "const": "submission_csv" } }
      },
      "then": { "properties": { "format": { "const": "csv" } } }
    }
  ]
}
