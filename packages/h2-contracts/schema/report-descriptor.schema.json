{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendashboard.local/schemas/h2/report-descriptor.schema.json",
  "title": "H2ReportDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportId",
    "runId",
    "kind",
    "format",
    "status",
    "generatedAt",
    "filename",
    "contentHash",
    "warnings",
    "safetyDisclaimer",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reportId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "kind": {
      "enum": [
        "single_event_diagnosis",
        "period_summary",
        "analysis_result_json",
        "submission_csv",
        "validation_metrics",
        "quality_report"
      ]
    },
    "format": { "enum": ["html", "json", "csv"] },
    "status": { "enum": ["ready", "failed"] },
    "generatedAt": { "type": "string", "minLength": 1 },
    "filename": { "type": "string", "minLength": 1 },
    "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "eventId": { "type": "string" },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "safetyDisclaimer": { "type": "string", "minLength": 1 },
    "provenance": { "type": "object" }
  }
}
