{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendashboard.local/schemas/h2/submission-row.schema.json",
  "title": "H2SubmissionRow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pred_event_id",
    "start_time",
    "end_time",
    "anomaly_code",
    "anomaly_subtype",
    "severity",
    "primary_control_object",
    "affected_equipment",
    "confidence",
    "evidence_json",
    "root_cause",
    "recommended_action",
    "primary_impact_metric",
    "estimated_impact_value",
    "first_detection_time",
    "requires_human_confirmation"
  ],
  "allOf": [
    {
      "oneOf": [
        { "properties": { "anomaly_code": { "const": "C01" }, "anomaly_subtype": { "const": "SETPOINT_OSCILLATION" }, "primary_impact_metric": { "const": "bess_extra_regulation_energy_kwh" } } },
        { "properties": { "anomaly_code": { "const": "C02" }, "anomaly_subtype": { "const": "CAPACITY_NOT_SYNCHRONIZED" }, "primary_impact_metric": { "const": "unserved_elz_energy_kwh" } } },
        { "properties": { "anomaly_code": { "const": "C03" }, "anomaly_subtype": { "const": "BESS_DIRECTION_REVERSED" }, "primary_impact_metric": { "const": "abnormal_grid_exchange_energy_kwh" } } },
        { "properties": { "anomaly_code": { "const": "C04" }, "anomaly_subtype": { "enum": ["EXPORT_POWER_LIMIT_NOT_TRACKED", "IMPORT_POWER_LIMIT_NOT_TRACKED"] }, "primary_impact_metric": { "const": "pcc_power_limit_violation_energy_kwh" } } },
        { "properties": { "anomaly_code": { "const": "C05" }, "anomaly_subtype": { "enum": ["EXPORT_ENERGY_QUOTA_RISK", "IMPORT_ENERGY_QUOTA_RISK"] }, "primary_impact_metric": { "const": "grid_energy_quota_deviation_kwh" } } },
        { "properties": { "anomaly_code": { "const": "C06" }, "anomaly_subtype": { "enum": ["AVOIDABLE_START_STOP", "INEFFICIENT_POWER_ALLOCATION"] }, "primary_impact_metric": { "const": "extra_energy_consumption_kwh" } } },
        { "properties": { "anomaly_code": { "const": "C07" }, "anomaly_subtype": { "enum": ["CHARGE_HEADROOM_SHORTFALL", "DISCHARGE_RESERVE_SHORTFALL"] }, "primary_impact_metric": { "const": "bess_regulation_reserve_shortfall_kwh" } } }
      ]
    }
  ],
  "properties": {
    "pred_event_id": { "type": "string", "minLength": 1 },
    "start_time": { "type": "string", "minLength": 1 },
    "end_time": { "type": "string", "minLength": 1 },
    "anomaly_code": {
      "enum": ["C01", "C02", "C03", "C04", "C05", "C06", "C07"]
    },
    "anomaly_subtype": {
      "enum": [
        "SETPOINT_OSCILLATION",
        "CAPACITY_NOT_SYNCHRONIZED",
        "BESS_DIRECTION_REVERSED",
        "EXPORT_POWER_LIMIT_NOT_TRACKED",
        "IMPORT_POWER_LIMIT_NOT_TRACKED",
        "EXPORT_ENERGY_QUOTA_RISK",
        "IMPORT_ENERGY_QUOTA_RISK",
        "AVOIDABLE_START_STOP",
        "INEFFICIENT_POWER_ALLOCATION",
        "CHARGE_HEADROOM_SHORTFALL",
        "DISCHARGE_RESERVE_SHORTFALL"
      ]
    },
    "severity": { "enum": ["low", "medium", "high", "critical"] },
    "primary_control_object": { "type": "string", "minLength": 1 },
    "affected_equipment": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence_json": { "type": "string", "minLength": 2 },
    "root_cause": { "type": "string", "minLength": 1 },
    "recommended_action": { "type": "string", "minLength": 1 },
    "primary_impact_metric": {
      "enum": [
        "bess_extra_regulation_energy_kwh",
        "unserved_elz_energy_kwh",
        "abnormal_grid_exchange_energy_kwh",
        "pcc_power_limit_violation_energy_kwh",
        "grid_energy_quota_deviation_kwh",
        "extra_energy_consumption_kwh",
        "bess_regulation_reserve_shortfall_kwh"
      ]
    },
    "estimated_impact_value": { "type": "number" },
    "first_detection_time": { "type": "string", "minLength": 1 },
    "requires_human_confirmation": { "type": "boolean" }
  }
}
