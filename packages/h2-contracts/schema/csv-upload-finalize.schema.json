{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendashboard.local/schemas/h2/csv-upload-finalize.schema.json",
  "title": "H2CsvUploadFinalizeRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "sessionId",
    "totalChunks",
    "totalBytes",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "totalChunks": { "type": "integer", "minimum": 1 },
    "totalBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 268435456
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
