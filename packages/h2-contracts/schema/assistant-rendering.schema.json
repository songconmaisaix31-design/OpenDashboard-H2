{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendashboard.local/schemas/h2/assistant-rendering.schema.json",
  "title": "H2AssistantRenderingResult",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "deterministicAnswerId", "status", "renderedText", "citationIds", "provenance"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "deterministicAnswerId": { "type": "string", "minLength": 1 },
        "status": { "const": "rendered" },
        "renderedText": { "type": "string", "minLength": 1 },
        "citationIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "provenance": {
          "type": "object",
          "required": ["mode", "source", "generatedAt", "modelVersion", "rendererVersion", "limitations"],
          "properties": {
            "mode": { "const": "LLM_RENDERED" },
            "source": { "type": "string", "minLength": 1 },
            "generatedAt": { "type": "string", "minLength": 1 },
            "modelVersion": { "type": "string", "minLength": 1 },
            "rendererVersion": { "type": "string", "minLength": 1 },
            "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "deterministicAnswerId", "status", "reason", "provenance"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "deterministicAnswerId": { "type": "string", "minLength": 1 },
        "status": { "const": "fallback" },
        "reason": {
          "enum": ["provider_unavailable", "timeout", "invalid_output"]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "source", "generatedAt", "limitations"],
          "properties": {
            "mode": { "enum": ["FIXTURE", "LIVE_ANALYSIS", "DERIVED", "MODEL", "RULE"] },
            "source": { "type": "string", "minLength": 1 },
            "generatedAt": { "type": "string", "minLength": 1 },
            "datasetFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "modelVersion": { "type": "string" },
            "ruleVersion": { "type": "string" },
            "configurationVersion": { "type": "string" },
            "rendererVersion": { "type": "string" },
            "limitations": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "deterministicAnswerId", "status", "reason", "provenance"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "deterministicAnswerId": { "type": "string", "minLength": 1 },
        "status": { "const": "disabled" },
        "reason": {
          "enum": ["not_requested", "not_configured", "policy_disabled"]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "source", "generatedAt", "limitations"],
          "properties": {
            "mode": { "enum": ["FIXTURE", "LIVE_ANALYSIS", "DERIVED", "MODEL", "RULE"] },
            "source": { "type": "string", "minLength": 1 },
            "generatedAt": { "type": "string", "minLength": 1 },
            "datasetFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "modelVersion": { "type": "string" },
            "ruleVersion": { "type": "string" },
            "configurationVersion": { "type": "string" },
            "rendererVersion": { "type": "string" },
            "limitations": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  ]
}
