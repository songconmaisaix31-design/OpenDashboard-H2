{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendashboard.local/schemas/h2/event-review.schema.json",
  "title": "H2EventReview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewId",
    "runId",
    "eventId",
    "initialState",
    "currentState",
    "revision",
    "entries",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reviewId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "eventId": { "type": "string", "minLength": 1 },
    "initialState": { "const": "open" },
    "currentState": { "enum": ["open", "confirmed", "dismissed", "resolved"] },
    "revision": { "type": "integer", "minimum": 0 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "entryId",
          "requestId",
          "revision",
          "action",
          "previousState",
          "nextState",
          "actor",
          "createdAt"
        ],
        "properties": {
          "schemaVersion": { "const": 1 },
          "entryId": { "type": "string", "minLength": 1 },
          "requestId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[\\x21-\\x7E]+$" },
          "revision": { "type": "integer", "minimum": 1 },
          "action": { "enum": ["confirm", "reject", "resolve", "reopen", "add_note"] },
          "previousState": { "enum": ["open", "confirmed", "dismissed", "resolved"] },
          "nextState": { "enum": ["open", "confirmed", "dismissed", "resolved"] },
          "note": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "actor": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "displayName"],
            "properties": {
              "kind": { "const": "local_operator" },
              "displayName": { "type": "string", "minLength": 1, "maxLength": 64 }
            }
          },
          "createdAt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "provenance": { "type": "object" }
  }
}
