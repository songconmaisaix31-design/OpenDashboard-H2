{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendashboard.local/schemas/h2/assistant-request.schema.json",
  "title": "H2AssistantRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "questionId", "allowLlmRendering"],
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "questionId": {
      "enum": ["Q01", "Q02", "Q03", "Q04", "Q05", "Q06", "Q07", "Q08", "Q09", "Q10"]
    },
    "eventId": { "type": "string", "minLength": 1 },
    "allowLlmRendering": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": {
        "required": ["questionId"],
        "properties": { "questionId": { "enum": ["Q03", "Q09"] } }
      },
      "then": { "required": ["eventId"] }
    }
  ]
}
