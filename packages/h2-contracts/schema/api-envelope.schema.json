{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendashboard.local/schemas/h2/api-envelope.schema.json",
  "title": "H2ApiEnvelope",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "status", "data", "warnings", "provenance"],
      "properties": {
        "ok": { "const": true },
        "status": { "const": "success" },
        "data": {},
        "warnings": { "type": "array", "maxItems": 0 },
        "provenance": { "type": "object" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "status", "data", "warnings", "provenance"],
      "properties": {
        "ok": { "const": true },
        "status": { "const": "warning" },
        "data": {},
        "warnings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "evidenceIds"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 },
              "field": { "type": "string" },
              "evidenceIds": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "provenance": { "type": "object" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "status", "error", "warnings", "provenance"],
      "properties": {
        "ok": { "const": false },
        "status": { "const": "error" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable", "incidentId", "details"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "retryable": { "type": "boolean" },
            "incidentId": { "type": "string", "minLength": 1 },
            "details": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "provenance": { "type": "object" }
      }
    }
  ]
}
