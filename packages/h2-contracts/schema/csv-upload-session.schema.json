{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendashboard.local/schemas/h2/csv-upload-session.schema.json",
  "title": "H2CsvUploadSessionCreateRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "filename", "declaredBytes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^/\\\\]+$"
    },
    "declaredBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 268435456
    },
    "expectedContentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
