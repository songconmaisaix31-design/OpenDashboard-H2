{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendashboard.local/schemas/h2/assistant-answer.schema.json",
  "title": "H2AssistantAnswer",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["questionId"],
        "properties": { "questionId": { "const": "Q09" } }
      },
      "then": { "required": ["eventId", "generatedReport"] },
      "else": { "not": { "required": ["generatedReport"] } }
    }
  ],
  "required": [
    "schemaVersion",
    "answerId",
    "runId",
    "questionId",
    "mode",
    "generatedAt",
    "sections",
    "citations",
    "refusedControlClaim",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "answerId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "questionId": {
      "enum": [
        "Q01",
        "Q02",
        "Q03",
        "Q04",
        "Q05",
        "Q06",
        "Q07",
        "Q08",
        "Q09",
        "Q10"
      ]
    },
    "mode": { "const": "DETERMINISTIC_TEMPLATE" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "eventId": { "type": "string" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sectionId", "claimKind", "text", "citationIds"],
        "properties": {
          "sectionId": { "type": "string", "minLength": 1 },
          "claimKind": {
            "enum": ["fact", "calculation", "inference", "recommendation"]
          },
          "text": { "type": "string", "minLength": 1 },
          "citationIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          }
        }
      }
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "citationId",
          "claimKind",
          "sourceType",
          "sourceId"
        ],
        "properties": {
          "citationId": { "type": "string", "minLength": 1 },
          "claimKind": {
            "enum": ["fact", "calculation", "inference", "recommendation"]
          },
          "sourceType": {
            "enum": [
              "event",
              "evidence",
              "constraint",
              "variable",
              "knowledge_base",
              "report"
            ]
          },
          "sourceId": { "type": "string", "minLength": 1 },
          "eventId": { "type": "string" }
        }
      }
    },
    "generatedReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["descriptor", "mediaType", "content"],
      "properties": {
        "descriptor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "reportId",
            "runId",
            "kind",
            "format",
            "status",
            "generatedAt",
            "filename",
            "contentHash",
            "eventId",
            "warnings",
            "safetyDisclaimer",
            "provenance"
          ],
          "properties": {
            "schemaVersion": { "const": 1 },
            "reportId": { "type": "string", "minLength": 1 },
            "runId": { "type": "string", "minLength": 1 },
            "kind": { "const": "single_event_diagnosis" },
            "format": { "const": "html" },
            "status": { "const": "ready" },
            "generatedAt": { "type": "string", "minLength": 1 },
            "filename": { "type": "string", "minLength": 1 },
            "contentHash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "eventId": { "type": "string", "minLength": 1 },
            "warnings": { "type": "array", "items": { "type": "string" } },
            "safetyDisclaimer": { "type": "string", "minLength": 1 },
            "provenance": { "type": "object" }
          }
        },
        "mediaType": { "const": "text/html" },
        "content": { "type": "string", "minLength": 1 }
      }
    },
    "refusedControlClaim": { "const": true },
    "provenance": { "type": "object" }
  }
}
